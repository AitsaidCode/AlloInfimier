# EmailJS Configuration
# Sign up at https://www.emailjs.com/ and fill these in.
# Copy this file to .env and replace with your real values.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Supabase Configuration (server-side only — used by Vercel API routes)
# Create a project at https://supabase.com/ and fill these in.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
